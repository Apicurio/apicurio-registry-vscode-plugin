{
    "name": "apicurio-registry-explorer",
    "displayName": "Apicurio Registry Explorer",
    "description": "Explore Apicurio Registry content.",
    "version": "1.0.4-dev",
    "publisher": "Apicurio",
    "author": {
        "name": "Apicurio",
        "url": "https://www.apicur.io/"
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/Apicurio/apicurio-registry-vscode-plugin.git"
    },
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Visualization"
    ],
    "icon": "resources/apicurio_icon.png",
    "activationEvents": [
        "onView:apicurioExplorer"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "viewsWelcome": [
            {
                "view": "apicurioExplorer",
                "contents": "Please wait until connection to your Apicurio registry or, in order to explore an Apicurio registry, you should :\n - configure a registry in your settings (Settings > Apicurio).\n - refresh the view.\n\n[Get Started](command:workbench.action.openSettings2)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "apicurio-explorer",
                    "title": "Apicurio Explorer",
                    "icon": "resources/apicurio_icon.svg"
                }
            ]
        },
        "views": {
            "apicurio-explorer": [
                {
                    "id": "apicurioExplorer",
                    "name": "Apicurio Explorer",
                    "icon": "resources/apicurio_icon.svg",
                    "contextualTitle": "Apicurio Explorer"
                },
                {
                    "id": "apicurioArtifactsExplorer",
                    "name": "Apicurio Artifacts Explorer",
                    "icon": "resources/apicurio_icon.svg"
                },
                {
                    "id": "apicurioBranchesExplorer",
                    "name": "Apicurio Branches Explorer",
                    "icon": "resources/apicurio_icon.svg"
                },
                {
                    "id": "apicurioArtifactVersionsExplorer",
                    "name": "Apicurio Versions Explorer",
                    "icon": "resources/apicurio_icon.svg"
                },
                {
                    "id": "apicurioMetasExplorer",
                    "name": "Apicurio Metas Explorer",
                    "icon": "resources/apicurio_icon.svg"
                }
            ]
        },
        "commands": [
            {
                "command": "apicurioExplorer.refresh",
                "title": "Refresh",
                "icon": "$(refresh)"
            },
            {
                "command": "apicurioExplorer.createGroup",
                "title": "Create Group",
                "icon": "$(add)"
            },
            {
                "command": "apicurioArtifactsExplorer.filter",
                "title": "Filter",
                "icon": "$(filter)"
            },
            {
                "command": "apicurioArtifactVersionsExplorer.filter",
                "title": "Filter",
                "icon": "$(filter)"
            },
            {
                "command": "apicurioArtifactVersionsExplorer.openVersion",
                "title": "Open",
                "icon": "$(go-to-file)"
            },
            {
                "command": "apicurioArtifactVersionsExplorer.openVersionReferences",
                "title": "Open & replace references",
                "icon": "$(find-replace)"
            },
            {
                "command": "apicurioArtifactVersionsExplorer.openComments",
                "title": "Open Comments",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "apicurioArtifactVersionsExplorer.addComment",
                "title": "Add Comment",
                "icon": "$(comment)"
            },
            {
                "command": "apicurioMetasExplorer.displayMetasValue",
                "title": "Display Metas Value",
                "icon": "$(zoom-in)"
            }
        ],
        "_": {
            "command": "apicurioExplorer.test",
            "title": "Test",
            "icon": "$(eye)"
        },
        "menus": {
            "commandPalette": [
                {
                    "command": "apicurioExplorer.refresh"
                }
            ],
            "view/title": [
                {
                    "command": "apicurioExplorer.refresh",
                    "when": "view == apicurioExplorer",
                    "group": "navigation"
                },
                {
                    "command": "apicurioExplorer.createGroup",
                    "when": "view == apicurioExplorer",
                    "group": "sidebar"
                },
                {
                    "command": "apicurioArtifactsExplorer.filter",
                    "when": "view == apicurioArtifactsExplorer",
                    "group": "navigation"
                },
                {
                    "command": "apicurioArtifactVersionsExplorer.filter",
                    "when": "view == apicurioArtifactVersionsExplorer",
                    "group": "navigation"
                },
                {
                    "command": "apicurioMetasExplorer.displayMetasValue",
                    "when": "view == apicurioMetasExplorer",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "apicurioArtifactVersionsExplorer.openVersion",
                    "when": "view == apicurioArtifactVersionsExplorer && viewItem != collapsibleItem",
                    "group": "inline"
                },
                {
                    "command": "apicurioArtifactVersionsExplorer.openVersionReferences",
                    "when": "view == apicurioArtifactVersionsExplorer && viewItem != collapsibleItem",
                    "group": "context1"
                },
                {
                    "command": "apicurioArtifactVersionsExplorer.openComments",
                    "when": "view == apicurioArtifactVersionsExplorer && viewItem != collapsibleItem",
                    "group": "context2"
                },
                {
                    "command": "apicurioArtifactVersionsExplorer.addComment",
                    "when": "view == apicurioArtifactVersionsExplorer && viewItem != collapsibleItem",
                    "group": "context3"
                }
            ]
        },
        "__": {
            "command": "apicurioExplorer.test",
            "when": "view == apicurioExplorer"
        },
        "configuration": [
            {
                "title": "Apicurio",
                "properties": {
                    "apicurio.api.version": {
                        "description": "The version of the Apicurio Registry API to use",
                        "type": "string",
                        "default": "v3",
                        "enum": [
                            "v3",
                            "v2"
                        ],
                        "markdownEnumDescriptions": [
                            "Core Registry API v3",
                            "Core Registry API v2"
                        ],
                        "enumItemLabels": [
                            "Core API v3",
                            "Core API v2"
                        ]
                    },
                    "apicurio.http.secure": {
                        "description": "Use HTTPS instead of HTTP",
                        "type": "boolean",
                        "default": false
                    },
                    "apicurio.http.host": {
                        "description": "The Apicurio registry host to explore",
                        "type": "string",
                        "default": ""
                    },
                    "apicurio.http.port": {
                        "description": "The Apicurio registry port (default : 80 for http | 443 for https)",
                        "type": "integer",
                        "default": 80
                    },
                    "apicurio.http.path": {
                        "description": "The Apicurio registry path",
                        "type": "string",
                        "default": "/apis/registry/v3/"
                    },
                    "apicurio.search.limit": {
                        "description": "The Apicurio search limit (number of artifacts to return)",
                        "type": "integer",
                        "default": 50
                    },
                    "apicurio.explorer.name": {
                        "description": "Display name (if exist) instead of ID in registry explorer view",
                        "type": "boolean",
                        "default": false
                    },
                    "apicurio.versions.reverse": {
                        "description": "Reverse Versions order by default",
                        "type": "boolean",
                        "default": false
                    },
                    "apicurio.tools.preview.format": {
                        "description": "Format document on preview",
                        "type": "boolean",
                        "default": "true"
                    },
                    "apicurio.tools.preview.OPENAPI": {
                        "description": "Open OPENAPI artifacts with SwaggerPreview (if 'Arjun.swagger-viewer' plugin is available)",
                        "type": "boolean",
                        "default": "true"
                    }
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint . --ext .ts,.tsx",
        "test": "extest setup-and-run './out/test/*-test.js' --code_settings settings.json --extensions_dir .test-extensions",
        "test-no-timeout": "extest setup-and-run './out/test/*-test.js' --code_settings settings.json --extensions_dir .test-extensions --mocha_config './src/test/.mocharc-debug.js'"
    },
    "devDependencies": {
        "@types/chai": "^4.3.11",
        "@types/mocha": "^10.0.6",
        "@types/node": "^18.19.25",
        "@types/vscode": "^1.82.0",
        "@typescript-eslint/eslint-plugin": "^7.2.0",
        "chai": "^4.4.1",
        "eslint": "^8.57.0",
        "mocha": "^10.3.0",
        "prettier": "3.2.4",
        "typescript": "^5.3.3",
        "vscode-extension-tester": "^7.2.0"
    },
    "dependencies": {
        "http": "^0.0.1-security",
        "https": "^1.0.0",
        "mime-types": "^2.1.34"
    }
}